  m_Script: {fileID: 11500000, guid: ee3e47527fa100b4ab6f2bb91cee8588, type: 3}
  m_Name: TutorialStep_Spin
  m_EditorClassIdentifier: Assembly-CSharp::TutorialStepData
  lines:
  - "Last up \u2014 spin control!"
  - Spin curves the ball's path after it leaves your hand.
  - "To apply spin, drag forward in a curved arc \u2014 like a half-circle."
  - Curve left to hook left, curve right to hook right.
  - Give it a try. Draw a semicircle as you release!
  condition: 3
  completionLines:
  - Excellent! You've mastered spin control!
  - You now know everything you need to bowl.
  - Good luck on the lanes!
